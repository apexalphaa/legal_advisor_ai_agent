# Which LLM provider to use: "anthropic", "gemini", "groq", "nvidia", or "azure"
LLM_PROVIDER=gemini

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_EXTRACTION=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_REASONING=claude-sonnet-5

# Gemini API key (free tier available) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
# GEMINI_MODEL_REASONING=gemini-3.5-flash

# Groq API key (free tier available) — https://console.groq.com/keys
# Fast, generous request quota (1000/day) — good for exercising bot/API
# plumbing end-to-end, but output quality is weaker than Anthropic/Gemini,
# and the free tier's 8,000 tokens/minute cap can be hit by a single
# Module 4 call on a long judgment (we send up to ~45,000 chars of judgment
# text per summarization call). Expect occasional 429s on Modules 4/5.
GROQ_API_KEY=
# GROQ_MODEL_EXTRACTION=openai/gpt-oss-20b
# GROQ_MODEL_REASONING=openai/gpt-oss-120b

# NVIDIA NIM API key (free dev tier) — https://build.nvidia.com/
# Open any model card and click "Get API Key" (key starts with nvapi-).
# Rate limit is ~40 requests/minute (not token-based like Groq) — a single
# pipeline run makes ~11 calls at most, comfortably under that, so no
# inter-call delay is needed here the way we added for Groq's TPM cap.
NVIDIA_API_KEY=
# NVIDIA_MODEL_EXTRACTION=meta/llama-3.1-8b-instruct
# NVIDIA_MODEL_REASONING=meta/llama-3.3-70b-instruct

# Azure OpenAI — requires an existing Azure OpenAI resource + deployment.
# AZURE_OPENAI_ENDPOINT is the resource's base URL (no trailing path), e.g.
# https://<resource-name>.openai.azure.com
# AZURE_OPENAI_CHAT_DEPLOYMENT is your deployment name (not the base model
# name), e.g. "gpt-5-mini" — used for both tiers unless you set the two
# optional per-tier overrides below. gpt-5-family and o-series (o1/o3/o4)
# deployments only support the default temperature; this is detected by
# deployment name and temperature is skipped automatically for those.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_DEPLOYMENT_EXTRACTION=
# AZURE_OPENAI_DEPLOYMENT_REASONING=

# Indian Kanoon API token — https://api.indiankanoon.org/documentation/
# Sent as header: Authorization: Token <value>
INDIAN_KANOON_API_TOKEN=

# Set to "true" to use fixture/mocked Indian Kanoon responses instead of
# calling the live API (useful before you have a token, or to avoid
# per-page billing while testing).
INDIAN_KANOON_MOCK=true

# Express API server (Phase B)
PORT=3000
# Per-request socket timeout in ms for a full pipeline run. Default (5 min)
# is padded generously — see the comment in src/server.js.
# API_TIMEOUT_MS=300000

# Telegram bot (Phase C) — get this from @BotFather, see setup checklist
TELEGRAM_BOT_TOKEN=
